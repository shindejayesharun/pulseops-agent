# PulseOps Environment Configuration

# Engine Mode: live | mock (mock runs 100% offline with zero API keys required)
LLM_MODE=mock

# Primary Provider: openai | grok
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Grok / xAI Configuration (Optional alternative provider)
XAI_API_KEY=
XAI_MODEL=grok-beta
XAI_BASE_URL=https://api.x.ai/v1

# Database Configuration
DATABASE_URL=sqlite:///./pulseops.db

# Agent Loop Safeguards
MAX_TOOL_ROUNDS=6
TOOL_TIMEOUT_SECONDS=10.0

# Server Configuration
HOST=0.0.0.0
PORT=8000
